# Sanity CMS (optional — site serves /content/*.json seed data until set)
# Create a free project at https://www.sanity.io/manage, then copy its ID here.
NEXT_PUBLIC_SANITY_PROJECT_ID=zic59q5d
NEXT_PUBLIC_SANITY_DATASET=production

# Contact form via Web3Forms (optional — form shows a "not connected yet" notice until set)
# Get a free access key at https://web3forms.com (enter the destination email, key arrives by email).
# The key is public-safe: it only identifies which inbox receives submissions.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
