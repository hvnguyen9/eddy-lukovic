# Sanity CMS (optional — site serves /content/*.json seed data until set)
# Create a free project at https://www.sanity.io/manage, then copy its ID here.
NEXT_PUBLIC_SANITY_PROJECT_ID=zic59q5d
NEXT_PUBLIC_SANITY_DATASET=production

# Contact form via Web3Forms — optional fallback. The primary place for the key is
# Studio -> Site Settings -> "Contact form key" (no deploy needed). This env var is only
# used when that CMS field is blank. Key is public-safe (routes to one inbox).
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
